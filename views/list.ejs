<%- include("partials/header") %>
<div class="container">
    <h1 class="title">ユーザー一覧</h1>
    <table>
        <thead>
            <tr>
                <th><p>ID</p></th>
                <th><p>Password</p></th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><p><%= user.id %></p></td>
                    <td><p><%= user.password %></p></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <% if(users.length === 0) { %>
        <p class="nouser">ユーザーが見つかりません</p>
    <% } %>
</div>
<%- include("partials/footer") %>