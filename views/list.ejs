<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="utf-8">
        <title>UserList</title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
        <header>
            <div class="container">
                <h1 class="appname">UserList</h1>
            </div>
        </header>
        <main>
            <div class="container">
                <form>
                    <input class="inputtext" type="text" />
                    <input class="submitbtn" type="submit" />
                </form>
            </div>
            <div class="container">
                <table>
                    <thead>
                        <tr>
                            <th><p>ID</p></th>
                            <th><p>Password</p></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><p>Taro</p></td>
                            <td><p>abcde</p></td>
                        </tr>
                        <tr>
                            <td><p>Hanako</p></td>
                            <td><p>12345</p></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
        <footer>
            <div class="container">
                <p>UserList produced by RepresentGenius</p>
            </div>
        </footer>
    </body>
</html>