<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="utf-8">
        <title>UserList</title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
        <header>
            <div class="container">
                <h1 class="appname">UserList</h1>
            </div>
        </header>
        <main>
            <div class="container">
                <form action="insert" method="POST">
                    <input class="inputtext" type="text" name="id"/>
                    <input class="inputtext" type="text" name="password"/>
                    <input class="submitbtn" type="submit" />
                </form>
            </div>
            <div class="container">
                <table>
                    <thead>
                        <tr>
                            <th><p>ID</p></th>
                            <th><p>Password</p></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                        <tr>
                            <td><p><%= user.id %></p></td>
                            <td><p><%= user.password %></p></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </main>
        <footer>
            <div class="container">
                <p>UserList produced by RepresentGenius</p>
            </div>
        </footer>
    </body>
</html>